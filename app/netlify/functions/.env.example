# Example environment variables for local testing
# Copy this file to .env and set real values before running locally

# Your Gemini API key (required for /api/chat and /api/chat/agent)
GEMINI_API_KEY=

# Optional: Gemini API base URL and model
GEMINI_BASE_URL=
GEMINI_MODEL=

# Port used by the local wrapper
PORT=8888

# Workspace directory (optional override). Defaults to /tmp/workspace
# WORKSPACE_DIR=/tmp/workspace

# Supabase configuration (required for expiry-notification cron job)
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://mskobghlcvvvlljfkbpr.supabase.co
# IMPORTANT: Use the service_role (secret) key, NOT the anon key
# The service role key bypasses RLS to read all users' data
SUPABASE_SERVICE_KEY=
